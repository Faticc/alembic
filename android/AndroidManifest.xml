<?xml version="1.0" encoding="utf-8"?>
<!-- Alembic для Android: одна NativeActivity, весь код - в libalembic_android.so. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.faticc.alembic"
    android:versionCode="601"
    android:versionName="0.6.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Сетевая игра: комнаты в локальной сети и вход по IP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Alembic"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="alembic_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
